# Local npm run: use localhost. Docker Compose overrides this to db:5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_learning"
PORT=3000
NODE_ENV=production
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.8-flash
JWT_SECRET=your_jwt_secret_here

# Admin bootstrap (used by prisma/seed.js — never commit a real password)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
